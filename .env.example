MINIO_ROOT_USER=pachyderm
MINIO_ROOT_PASSWORD=pachyderm-secret-key-123456789
MINIO_ENDPOINT=http://minio:9000
AIRFLOW_S3_BUCKET=pachyderm

AIRFLOW_SECRET_KEY=dev-secret-key
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin123
AIRFLOW_ADMIN_FIRSTNAME=Local
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@local.test
AIRFLOW_DAG_ID=ingest_pipeline_local

# Read-only local provenance API. Comma-separate exact browser origins when a
# local UI needs CORS; leave blank for CLI/server-side access only.
PROVENANCE_API_HOST_PORT=8010
PROVENANCE_API_ALLOWED_ORIGINS=

# Provenance / OpenLineage. CI should inject the full immutable Git SHA and
# image digest; leave either value blank when its exact identity is unavailable.
OPENLINEAGE_NAMESPACE=babelapha.local
BABELAPHA_GIT_SHA=
BABELAPHA_RUNTIME_IMAGE=babelapha-airflow-local
BABELAPHA_RUNTIME_IMAGE_DIGEST=

# Production processing images can be supplied as image@sha256:<digest> to make
# the manifest's container identity exact.
BABELAPHA_SCAN_IMAGE=localhost/clamav:latest
BABELAPHA_VALIDATE_IMAGE=localhost/validate:latest
BABELAPHA_TRANSCODE_IMAGE=localhost/transcode:latest

MARQUEZ_DB_NAME=marquez
MARQUEZ_DB_USER=marquez
MARQUEZ_DB_PASSWORD=marquez
