{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KG-khangelani/babelapha/main/contracts/openlineage-babelapha-execution-run-facet-v2.schema.json",
  "title": "Babelapha OpenLineage execution run facet v2",
  "description": "The non-artifact execution evidence copied from one canonical Babelapha provenance manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_producer",
    "_schemaURL",
    "schemaVersion",
    "manifestId",
    "manifestUri",
    "recordedAt",
    "objectId",
    "objectFilename",
    "airflowRunId",
    "dagId",
    "taskId",
    "stage",
    "attempt",
    "status",
    "startedAt",
    "completedAt",
    "durationMs",
    "decisionOutcome",
    "decisionReasonCode",
    "decisionMessage",
    "gitRepository",
    "gitCommit",
    "codePath",
    "codeSha256",
    "containerImage",
    "containerDigest",
    "containerIdentityStatus",
    "parameters",
    "orchestratorName",
    "orchestratorVersion",
    "airflowLogUrl"
  ],
  "properties": {
    "_producer": {"type": "string", "format": "uri"},
    "_schemaURL": {"type": "string", "format": "uri"},
    "schemaVersion": {"const": "1.0.0"},
    "manifestId": {"type": "string", "format": "uuid"},
    "manifestUri": {"type": "string", "format": "uri"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "objectId": {"type": "string", "minLength": 1},
    "objectFilename": {"type": "string", "minLength": 1},
    "airflowRunId": {"type": "string", "minLength": 1},
    "dagId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["SUCCEEDED", "FAILED", "RETRYING", "SKIPPED"]},
    "startedAt": {"type": ["string", "null"], "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "durationMs": {"type": ["integer", "null"], "minimum": 0},
    "decisionOutcome": {"type": "string", "minLength": 1},
    "decisionReasonCode": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "decisionMessage": {"type": "string"},
    "gitRepository": {"type": "string"},
    "gitCommit": {"type": ["string", "null"], "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"},
    "codePath": {"type": "string", "minLength": 1},
    "codeSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "containerImage": {"type": "string", "minLength": 1},
    "containerDigest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "containerIdentityStatus": {"enum": ["VERIFIED_DIGEST", "CONFIGURED_REF_ONLY"]},
    "parameters": {"type": "object"},
    "orchestratorName": {"const": "airflow"},
    "orchestratorVersion": {"type": ["string", "null"]},
    "airflowLogUrl": {"type": ["string", "null"]}
  }
}
