{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KG-khangelani/babelapha/main/contracts/openlineage-babelapha-artifact-dataset-facet-v1.schema.json",
  "title": "Babelapha OpenLineage artifact dataset facet v1",
  "description": "Exact content and storage-version evidence copied from one canonical manifest artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_producer",
    "_schemaURL",
    "uri",
    "kind",
    "sha256",
    "sizeBytes",
    "mediaType",
    "integrity",
    "pachydermCommit",
    "s3VersionId",
    "etag"
  ],
  "properties": {
    "_producer": {"type": "string", "format": "uri"},
    "_schemaURL": {"type": "string", "format": "uri"},
    "uri": {"type": "string", "format": "uri"},
    "kind": {"enum": ["OBJECT", "PREFIX"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "sizeBytes": {"type": ["integer", "null"], "minimum": 0},
    "mediaType": {"type": ["string", "null"]},
    "integrity": {"enum": ["VERIFIED", "UNVERIFIED"]},
    "pachydermCommit": {"type": ["string", "null"]},
    "s3VersionId": {"type": ["string", "null"]},
    "etag": {"type": ["string", "null"]}
  }
}
