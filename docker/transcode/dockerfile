# file: docker/transcode/Dockerfile
FROM docker.io/jrottenberg/ffmpeg:8.0.3-ubuntu2404
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip curl jq \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages awscli==1.46.1

# Install the published pachctl release archive and fail if the asset is missing.
ARG PACHCTL_VERSION=2.12.2
ARG PACHCTL_SHA256=843a4e18288225e94f72531a7037dc00c178a2288a29798fefe9b8f03e686e22
RUN curl -fsSL -o /tmp/pachctl.tar.gz \
        "https://github.com/pachyderm/pachyderm/releases/download/v${PACHCTL_VERSION}/pachctl_${PACHCTL_VERSION}_linux_amd64.tar.gz" \
    && echo "${PACHCTL_SHA256}  /tmp/pachctl.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/pachctl.tar.gz --strip-components=1 -C /usr/local/bin \
    && chmod +x /usr/local/bin/pachctl \
    && rm /tmp/pachctl.tar.gz

COPY docker/utils/pfs_move.py /app/pfs_move.py
COPY docker/transcode/transcode.py /app/transcode.py
WORKDIR /app
ENTRYPOINT ["python3","/app/transcode.py"]
