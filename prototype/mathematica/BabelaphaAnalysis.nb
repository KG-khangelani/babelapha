\"fundamental_frequency_hz\" -> distributionStatistics[pitchValues]\n        \
|>,\n        \"availability\" -> <|\n            \"rms_amplitude\" -> \
featureAvailability[rmsSeries, \"RMS amplitude was not available.\"],\n       \
     \"peak_amplitude\" -> featureAvailability[peakSeries, \"Local peak \
amplitude was not available.\"],\n            \"spectral_centroid\" -> \
featureAvailability[centroidSeries, \"Spectral centroid was not \
