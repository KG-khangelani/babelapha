&],\n        \"MIXED_WITH_ESTIMATED_SENTENCE_TIMING\",\n        \
\"SOURCE_SEGMENTS\"\n    ];\n    <|\n        \"status\" -> \"AVAILABLE\",\n   \
     \"reason\" -> \"\",\n        \"method\" -> \"sentence navigation derived \
from verified transcript segments; proportional boundaries are estimates, not \
word timestamps\",\n        \"timing_basis\" -> basis,\n        \
\"speaker_diarization\" -> \"NOT_PERFORMED\",\n        \"segment_count\" -> \
Length[segments],\n        \"segments\" -> segments\n    |>\n];\n\n"], 
