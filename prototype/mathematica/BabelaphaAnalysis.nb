N[region[\"end_seconds\"] - region[\"start_seconds\"]]},\n                \
Join[\n                    <|\"region_index\" -> First[index]|>,\n            \
        region,\n                    <|\n                        \
\"duration_seconds\" -> duration,\n                        \
\"activity_fraction\" -> If[duration > 0., \
N[region[\"active_duration_seconds\"]/duration], 0.]\n                    \
|>\n                ]\n            ]\n        ],\n        result\n    \
]\n];\n\nmediaAudioActivity[media_Association, parameters_Association] := \
