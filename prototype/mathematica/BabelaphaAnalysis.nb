\"start\", 0.] <= cursor <= Lookup[#, \"end\", 0.] &, \
Missing[\"NoActivity\"]];\n                            activeEvent = \
SelectFirst[\n                                storedEvents,\n                 \
               With[{window = Lookup[#, \"window_seconds\", {}]}, \
ListQ[window] && Length[window] == 2 && First[window] <= cursor <= \
Last[window]] &,\n                                Missing[\"NoEvent\"]\n      \
                      ];\n                            nearestEvent = If[\n    \
                            ! MissingQ[activeEvent],\n                        \
        activeEvent,\n                                If[storedEvents === {}, \
Missing[\"NoEvent\"], First@MinimalBy[storedEvents, Abs[Lookup[#, \
\"time_seconds\", 0.] - cursor] &]]\n                            ];\n         \
                   nearestSample = If[storedAligned === {}, \
Missing[\"NoSample\"], First@MinimalBy[storedAligned, Abs[Lookup[#, \
\"time_seconds\", 0.] - cursor] &]];\n                            statusRows \
= {\n                                {\"Cursor\", ToString[NumberForm[cursor, \
{Infinity, 3}]] <> \" s\"},\n                                {\"Audio \
activity\", If[MissingQ[activeActivity], \"Below the emitted RMS activity \
regions\", \"Region \" <> ToString[Lookup[activeActivity, \"region_index\", \
\"?\"]] <> \" (RMS activity, not diarization)\"]},\n                          \
      {\"Speech text\", If[MissingQ[activeSpeech], \"No timestamped speech \
segment covers this time\", Lookup[activeSpeech, \"text\", \"\"]]},\n         \
                       {\"Speech timing\", If[MissingQ[activeSpeech], \"Not \
available\", ToString[Lookup[activeSpeech, \"timing_basis\", \
\"unknown\"]]]},\n                                {\"Visual scene\", \
If[MissingQ[activeScene], \"No derived scene covers this time\", \"Scene \" \
<> ToString[Lookup[activeScene, \"scene_index\", \"?\"]] <> \", mean color \" \
<> ToString[Lookup[activeScene, \"representative_color_hex\", \
\"unknown\"]]]},\n                                {\"Nearest cross-modal \
event\", If[MissingQ[nearestEvent], \"No event emitted\", \
