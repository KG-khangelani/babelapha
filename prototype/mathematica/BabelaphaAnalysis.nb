                          {\"Mean RGB\", NumberForm[storedRGB[[frameIndex]], \
{4, 3}]},\n                                                {\"Brightness\", \
NumberForm[storedBrightness[[frameIndex]], {4, 3}]},\n                        \
                        {\"Mean color\", Graphics[{RGBColor @@ \
Clip[storedRGB[[frameIndex]], {0., 1.}], Rectangle[]}, ImageSize -> {120, \
24}]}\n                                            },\n                       \
                     Alignment -> Left\n                                      \
  ]\n                                    },\n                                 \
   Alignment -> Center\n                                ]\n                   \
         ];\n                            pairs = storedSeries[metric];\n      \
                      selectedAudio = If[audioSeriesAvailable, \
First@MinimalBy[pairs, Abs[First[#] - cursor] &], Missing[\"NoAudio\"]];\n    \
                        valueRange = MinMax[N[pairs[[All, 2]]]];\n            \
                If[First[valueRange] == Last[valueRange], valueRange = \
First[valueRange] + {-0.5, 0.5}];\n                            audioPlot = \
If[\n                                audioSeriesAvailable,\n                  \
              Column[\n                                    {\n                \
                        ListLinePlot[\n                                       \
     pairs,\n                                            Frame -> True,\n     \
                                       Axes -> False,\n                       \
                     FrameLabel -> {\"Time (seconds)\", metric},\n            \
                                PlotRange -> All,\n                           \
                 Epilog -> {Red, Dashed, Line[{{cursor, First[valueRange]}, \
{cursor, Last[valueRange]}}], PointSize[Medium], Point[selectedAudio]},\n     \
                                       ImageSize -> Large\n                   \
                     ],\n                                        \
Row[{\"Nearest \", metric, \": \", NumberForm[Last[selectedAudio], {Infinity, \
4}], \" at \", NumberForm[First[selectedAudio], {Infinity, 3}], \" s\"}]\n    \
                                }\n                                ],\n       \
                         Style[\"No timestamped audio measurement is \
available.\", Italic]\n                            ];\n                       \
     activeSpeech = SelectFirst[storedSpeech, Lookup[#, \"start\", 0.] <= \
cursor <= Lookup[#, \"end\", 0.] &, Missing[\"NoSpeech\"]];\n                 \
           activeScene = SelectFirst[storedScenes, Lookup[#, \"start\", 0.] \
<= cursor <= Lookup[#, \"end\", 0.] &, Missing[\"NoScene\"]];\n               \
