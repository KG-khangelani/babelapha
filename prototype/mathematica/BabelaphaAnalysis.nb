notebookLookup[media, \"video_analytics\", <||>];\n    frames = \
notebookLookup[media, \"frames\", {}];\n    If[! ListQ[frames], frames = \
{}];\n    duration = notebookLookup[measurements, \"duration_seconds\", \
notebookLookup[media, \"duration_seconds\", Null]];\n    times = \
