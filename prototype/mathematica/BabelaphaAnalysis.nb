\"UNAVAILABLE\", RGBColor[.70, .39, .08], _, GrayLevel[.35]]],\n              \
      notebookLookup[detail, \"reason\", \"\"]\n                }\n           \
 ]\n        ],\n        capabilities\n    ];\n    Grid[\n        \
Prepend[rows, Style[#, Bold] & /@ {\"Capability\", \"Status\", \"Reason / \
scope\"}],\n        Alignment -> Left,\n        Frame -> All,\n        \
Spacings -> {.8, .7}\n    ]\n];\n\n"], "Input", InitializationCell -> True, 
      CellTags -> {"BabelaphaDefinitions"}]}, Closed]], 
  Cell[CellGroupData[{Cell["Executable notebook assembly", "Section"], 
     Cell["Builds the local result notebook while carrying these exact source \
