notebookLookup[input, \"run_id\", Null],\n        \"source_path\" -> \
notebookLookup[source, \"path\", Null],\n        \"source_size\" -> \
notebookHumanBytes[notebookLookup[source, \"size_bytes\", Null]],\n        \
\"source_sha256\" -> notebookShortHash[notebookLookup[source, \"sha256\", \
