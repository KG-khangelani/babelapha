};\n    rgbMean = notebookLookup[videoSummary, \"mean_rgb\", <||>];\n    \
audioAnalysis = notebookLookup[media, \"audio_analysis\", <||>];\n    \
audioSummary = notebookLookup[audioAnalysis, \"summary\", <||>];\n    \
audioAvailable = TrueQ[notebookLookup[audioAnalysis, \"available\", \
