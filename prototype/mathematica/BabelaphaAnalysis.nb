markdown, html, notebook, outputs, capabilities, visuals},\n    If[! \
DirectoryQ[outputDirectory], CreateDirectory[outputDirectory, \
CreateIntermediateDirectories -> True]];\n    audioPNG = \
FileNameJoin[{outputDirectory, \"audio-overview.png\"}];\n    audioSVG = \
FileNameJoin[{outputDirectory, \"audio-overview.svg\"}];\n    contactPNG = \
FileNameJoin[{outputDirectory, \"video-contact-sheet.png\"}];\n    summaryPNG \
= FileNameJoin[{outputDirectory, \"video-summary.png\"}];\n    markdownPath = \
FileNameJoin[{outputDirectory, \"report.md\"}];\n    htmlPath = \
FileNameJoin[{outputDirectory, \"report.html\"}];\n    notebookPath = \
FileNameJoin[{outputDirectory, \"analysis-notebook.nb\"}];\n    capabilities \
= media[\"capabilities\"];\n    audioGraphic = \
audioOverviewGraphic[media[\"audio_analysis\"]];\n    exportChecked[audioPNG, \
audioGraphic, \"PNG\"];\n    audioVectorGraphic = \
audioVectorOverviewGraphic[media[\"audio_analysis\"]];\n    \
exportChecked[audioSVG, audioVectorGraphic, \"SVG\"];\n    contact = \
contactSheetImage[media[\"frames\"]];\n    exportChecked[contactPNG, contact, \
\"PNG\"];\n    summaryPlot = summaryPlotWithFallback[media];\n    \
If[MatchQ[summaryPlot, _Graphics] && ! FreeQ[summaryPlot, \"VideoSummaryPlot \
unavailable\"],\n        capabilities[\"video_summary_plot\"] = \
capability[\"UNAVAILABLE\", \"VideoSummaryPlot did not render; a diagnostic \
placeholder was exported.\"]\n    ];\n    exportChecked[summaryPNG, \
summaryPlot, \"PNG\"];\n    markdown = markdownReport[input, measurements, \
provenance, capabilities];\n    exportChecked[markdownPath, markdown, \
\"Text\"];\n    html = htmlReport[input, measurements, provenance, \
capabilities];\n    exportChecked[htmlPath, html, \"Text\"];\n    visuals = \
<|\n        \"audio_overview\" -> \
notebookAudioOverviewPanel[media[\"audio_analysis\"]],\n        \
\"video_contact_sheet\" -> contact,\n        \"video_summary\" -> \
ImageResize[Import[summaryPNG], 720]\n    |>;\n    notebook = \
analysisNotebook[input, media, measurements, provenance, capabilities, \
visuals, outputDirectory, sourceNotebook, inputPath];\n    \
