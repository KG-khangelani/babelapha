\"method\" -> \"RMS-threshold intervals merged across short gaps; activity is \
not speaker diarization\",\n            \"threshold_dbfs\" -> \
N[Lookup[parameters, \"silence_threshold_db\", -40.]],\n            \
\"merge_gap_seconds\" -> mergeGap,\n            \"minimum_region_seconds\" -> \
