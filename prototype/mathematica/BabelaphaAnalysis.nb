            MissingQ[bounds],\n                    Missing[\"NoBounds\"],\n   \
                 Join[<|\"start\" -> First[bounds], \"end\" -> \
Last[bounds]|>, segment]\n                ]\n            ]\n        ],\n      \
  Select[sceneSegments, AssociationQ]\n    ];\n    activityRecords = \
