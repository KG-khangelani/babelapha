        \"timing_basis\" -> notebookLookup[segment, \"timing_basis\", \
\"SOURCE_SEGMENT\"]\n                    |>\n                ]\n            \
]\n        ],\n        Select[speechSegments, AssociationQ]\n    ];\n    \
sceneRecords = DeleteMissing@Map[\n        Function[segment,\n            \
